// SPDX-License-Identifier: Apache-2.0
//
// Kernel modules the recovery of mondrian loads itself: init.recovery.qcom.rc
// of device/xiaomi/sm8450-common insmods them from /vendor/lib/modules of the
// recovery ramdisk before it starts the ADSP (battery status), as the stock
// OS3.0.8.0 recovery does. They are the vendor_dlkm modules of this release;
// their other dependencies are in vendor_ramdisk/modules.load.recovery.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

prebuilt_vendor {
    name: "mondrian_recovery_q6_pdr_dlkm",
    src: "vendor_dlkm/q6_pdr_dlkm.ko",
    filename: "q6_pdr_dlkm.ko",
    relative_install_path: "lib/modules",
    recovery: true,
    install_in_root: true,
}

prebuilt_vendor {
    name: "mondrian_recovery_q6_notifier_dlkm",
    src: "vendor_dlkm/q6_notifier_dlkm.ko",
    filename: "q6_notifier_dlkm.ko",
    relative_install_path: "lib/modules",
    recovery: true,
    install_in_root: true,
}

prebuilt_vendor {
    name: "mondrian_recovery_snd_event_dlkm",
    src: "vendor_dlkm/snd_event_dlkm.ko",
    filename: "snd_event_dlkm.ko",
    relative_install_path: "lib/modules",
    recovery: true,
    install_in_root: true,
}

prebuilt_vendor {
    name: "mondrian_recovery_gpr_dlkm",
    src: "vendor_dlkm/gpr_dlkm.ko",
    filename: "gpr_dlkm.ko",
    relative_install_path: "lib/modules",
    recovery: true,
    install_in_root: true,
}

prebuilt_vendor {
    name: "mondrian_recovery_spf_core_dlkm",
    src: "vendor_dlkm/spf_core_dlkm.ko",
    filename: "spf_core_dlkm.ko",
    relative_install_path: "lib/modules",
    recovery: true,
    install_in_root: true,
}

prebuilt_vendor {
    name: "mondrian_recovery_adsp_loader_dlkm",
    src: "vendor_dlkm/adsp_loader_dlkm.ko",
    filename: "adsp_loader_dlkm.ko",
    relative_install_path: "lib/modules",
    recovery: true,
    install_in_root: true,
}
